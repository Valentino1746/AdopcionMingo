<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="8dp" app:cardCornerRadius="16dp" app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp">

        <ImageView android:id="@+id/imgMascotaSolicitud"
            android:layout_width="80dp" android:layout_height="80dp"
            android:layout_marginEnd="12dp" android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/txtNombreMascotaSolicitud"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/texto_principal" android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView android:id="@+id/txtTipoMascotaSolicitud"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/naranja_primario" android:textSize="13sp"
                android:layout_marginTop="2dp"/>

            <TextView android:id="@+id/txtFechaSolicitud"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/gris_subtitulo" android:textSize="11sp"
                android:layout_marginTop="2dp"/>

            <TextView android:id="@+id/txtEstadoSolicitud"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="3dp" android:paddingBottom="3dp"
                android:layout_marginTop="6dp" android:textSize="12sp" android:textStyle="bold"
                android:background="@drawable/ic_chip_background"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>