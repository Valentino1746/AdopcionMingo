<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_logo_adoptame_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AdoptaMe"
            android:textColor="@color/naranja_primario"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualiza tu contraseña para seguir\nayudando animalitos"
            android:textAlignment="center"
            android:textColor="@color/gris_subtitulo"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/ic_login_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recuperar contraseña"
                android:textColor="@color/texto_principal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ingresa tu correo y crea una nueva contraseña"
                android:textColor="@color/gris_subtitulo"
                android:textSize="13sp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="Correo electrónico"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Ingresa tu correo"
                android:inputType="textEmailAddress" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Nueva contraseña"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etNuevaPassword" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Ingresa tu nueva contraseña"
                android:inputType="textPassword" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Confirmar contraseña"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etConfirmarPassword" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Confirma tu nueva contraseña"
                android:inputType="textPassword" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <Button
                android:id="@+id/btnActualizar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/ic_button_primary_background"
                android:text="Actualizar contraseña"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>