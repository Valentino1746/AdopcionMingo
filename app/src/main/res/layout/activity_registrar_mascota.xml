<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Registrar mascota"
            android:textColor="@color/naranja_primario"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="Ingresa los datos para encontrarle un hogar"
            android:textColor="@color/gris_subtitulo"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/ic_login_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Datos del animalito"
                android:textColor="@color/texto_principal"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:text="Completa la información básica para publicarlo en adopción"
                android:textColor="@color/gris_subtitulo"
                android:textSize="12sp" />

            <!-- Nombre -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="Nombre"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etNombre" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Ej. Luna, Max, Toby"
                android:inputType="text" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <!-- Tipo de mascota (Spinner) -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Tipo de mascota"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <Spinner
                android:id="@+id/spinnerTipo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Raza -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Raza"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etRaza" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Ej. Mestizo, labrador, siamés"
                android:inputType="text" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <!-- Sexo (RadioGroup) -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Sexo"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <RadioGroup
                android:id="@+id/radioGroupSexo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/radioMacho" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Macho"
                    android:textColor="@color/texto_principal" android:layout_marginEnd="24dp"/>
                <RadioButton android:id="@+id/radioHembra" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Hembra"
                    android:textColor="@color/texto_principal"/>
            </RadioGroup>

            <Button
                android:id="@+id/btnRegistrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/ic_button_primary_background"
                android:text="Registrar"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Ayúdalo a encontrar una familia"
                android:textColor="@color/gris_hint"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>