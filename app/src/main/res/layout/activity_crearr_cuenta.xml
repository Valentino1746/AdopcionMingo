<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_logo_adoptame_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AdoptaMe"
            android:textColor="@color/naranja_primario"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/ic_login_card_background"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear cuenta"
                android:textColor="@color/texto_principal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Nombre -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Nombre *"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etNombre" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Tu nombre"
                android:inputType="textPersonName" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <!-- Apellido Paterno -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Apellido Paterno *"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etApellidoPaterno" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Apellido paterno"
                android:inputType="textPersonName" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <!-- Apellido Materno -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Apellido Materno"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etApellidoMaterno" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Apellido materno"
                android:inputType="textPersonName" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <!-- Email -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Correo electrónico *"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="ejemplo@correo.com"
                android:inputType="textEmailAddress" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <!-- Password -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Contraseña *"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etPassword" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Crea tu contraseña"
                android:inputType="textPassword" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <!-- Confirmar Password -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Confirmar contraseña *"
                android:textColor="@color/texto_principal" android:textSize="14sp" android:textStyle="bold"/>
            <EditText android:id="@+id/etConfirmarPassword" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="6dp"
                android:background="@drawable/ic_input_background" android:hint="Repite tu contraseña"
                android:inputType="textPassword" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:textColorHint="@color/gris_hint"/>

            <Button
                android:id="@+id/btnCrearCuenta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/ic_button_primary_background"
                android:text="Crear cuenta"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="Adopta · Cuida · Ama"
            android:textColor="@color/gris_hint"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>